---
const experiences = [
  {
    id: 1,
    period: "08/2018 - Present",
    company: "GOTT - Soluções Tecnológicas lda",
    location: "Porto, Portugal",
    role: "Mobile Software Developer",
    image: "/images/exp-gott.webp",
    description: "",
    achievements: [
      "Development of new functionalities and maintenance of existing software in the company (Launcher, VOIP, content delivery, provisioning) in Java.",
      "Development of a GPS application and integration with other existing software in the company in Java/Kotlin.",
      "Development of a multi-platform application for selling and installing eSIMs using Flutter.",
      "Development of reusable Flutter packages for internal use.",
      "Development of custom Flutter plugins by integrating native Android SDKs to access platform-specific functionalities (VOIP/eSIM).",
      "Managed iOS release processes via Xcode and conducted on-device debugging for iPhones.",
      "Architected and implemented a monorepo using Melos to consolidate two separate applications, maximizing code sharing between projects and significantly accelerating development cycles."
    ],
    projects: [
      { 
        name: "Millenium Estoril Open 2024", 
        client: "InnoWave", 
        period: "Jan 2024 - Mar 2024", 
        description: "Outsourced Project on InnoWave from Jan 2024 to Mar 2024. Development and update of the Millenium Estoril Open app 2024 using Kotlin."
      },
      { 
        name: "Tim Mais Application", 
        client: "TIMWETECH", 
        period: "Sep 2023 - Dec 2023", 
        description: "Outsourced Project on TIMWETECH from Sep 2023 to Dec 2023. Development of the 'Tim Mais' application using Flutter, a platform for TIM customers."
      }
    ]
  },
  {
    id: 2,
    period: "07/2016 - 07/2018",
    company: "Norteng - Engenharia lda",
    location: "Matosinhos, Portugal",
    role: "Android Software Developer",
    image: "/images/exp-norteng.webp",
    description: "",
    achievements: [
      "Development of an application for collecting data in the field of CVP, buildings, electricity poles, and their wiring, for Android tablets, in Java/Kotlin.",
      "Development of an application for automated data import, formatting, and export, in C#."
    ],
    projects: []
  },
  {
    id: 3,
    period: "03/2015 - 03/2016",
    company: "SmartStep - Sistemas de Mobilidade Integrado",
    image: "/images/exp-smartstep.webp",
    location: "Santo Tirso, Portugal",
    role: "Software Developer",
    description: "",
    achievements: [
      "Development of applications for access management, visitor management, and biometric devices, in C#.",
      "Integration of biometric and RFID devices with other existing software in the company, in C#.",
      "Development of reports in SAP Crystal Reports for other existing software in the company.",
      "Import and export of data from other existing software in the company to third-party softwares, in C#."
    ],
    projects: []
  },
  {
    id: 4,
    period: "03/2010 - 07/2010",
    company: "Pragmasoft Projectos e Software",
    location: "Matosinhos, Portugal",
    role: "Software Developer (Academic Internship)",
    description: "",
    achievements: [
      "Developed a foundational Bluetooth communication framework for C# and J2ME applications."
    ],
    projects: []
  }
];
---

<section id="experience" class="experience">
  <div class="container">
    <h2 class="section-title fade-in">▶ EXPERIENCE ◀</h2>
    
    <div class="timeline">
      {experiences.map((exp, index) => (
        <div class="timeline-item" style={`animation-delay: ${index * 0.2}s`}>
          <div class="job-card">
            <div class="job-header">
              <div class="job-period">
                <span class="period-icon">📅</span>
                <span>{exp.period}</span>
              </div>
              <div class="job-company">
                <span class="company-icon">🏢</span>
                <span>{exp.company}</span>
              </div>
            </div>
            
            <div class="job-info-row">
              {exp.image && (
                <div class="company-logo">
                  <img src={exp.image} alt={exp.company} class="company-image" />
                </div>
              )}
              <div class="job-details">
                <h3 class="job-role">{exp.role}</h3>
                <div class="job-location">
                  <span class="location-icon">📍</span>
                  <span>{exp.location}</span>
                </div>
              </div>
            </div>
            
            {exp.achievements.length > 0 && (
              <div class="achievements">
                <h4 class="achievements-title">QUEST LOG:</h4>
                <ul class="achievements-list">
                  {exp.achievements.map(achievement => (
                    <li class="achievement-item">
                      <span class="achievement-icon">✓</span>
                      <span>{achievement}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )}
            
            {exp.projects.length > 0 && (
              <div class="projects-subsection">
                <h4 class="projects-title">SIDE QUESTS (Outsourcing):</h4>
                <div class="project-list">
                  {exp.projects.map(project => (
                    <div class="project-card">
                      <div class="project-header">
                        <span class="project-name">{project.name}</span>
                        <span class="project-client">@ {project.client}</span>
                      </div>
                      <div class="project-period">{project.period}</div>
                      <p class="project-description">{project.description}</p>
                    </div>
                  ))}
                </div>
              </div>
            )}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .experience {
    background: linear-gradient(180deg, var(--terminal-black) 0%, var(--terminal-black-light) 100%);
  }
  
  .timeline {
    position: relative;
    padding-left: 40px;
  }
  
  .timeline::before {
    content: '';
    position: absolute;
    left: 10px;
    top: 0;
    bottom: 0;
    width: 4px;
    background: linear-gradient(180deg, var(--terminal-green), var(--accent-cyan), var(--terminal-green));
    box-shadow: 0 0 10px var(--terminal-green);
  }
  
  .timeline-item {
    position: relative;
    margin-bottom: 3rem;
    opacity: 0;
    animation: slideInLeft 0.6s ease-out forwards;
  }
  
  .timeline-item::before {
    content: '';
    position: absolute;
    left: -38px;
    top: 20px;
    width: 20px;
    height: 20px;
    background: var(--terminal-green);
    border: 4px solid var(--terminal-black);
    box-shadow: 
      0 0 0 2px var(--terminal-green),
      0 0 10px var(--terminal-green);
    animation: pulse 2s infinite;
  }
  
  .job-card {
    background: rgba(22, 27, 34, 0.8);
    border: 3px solid var(--terminal-green-dark);
    padding: 2rem;
    transition: all 0.3s ease;
  }
  
  .job-card:hover {
    border-color: var(--terminal-green);
    box-shadow: 
      0 0 30px rgba(0, 255, 65, 0.2),
      inset 0 0 30px rgba(0, 255, 65, 0.05);
    transform: translateX(10px);
  }
  
  .job-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
    flex-wrap: wrap;
    gap: 1rem;
  }
  
  .job-period,
  .job-company {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-pixel);
    font-size: 0.7rem;
    color: var(--accent-yellow);
  }
  
  .period-icon,
  .company-icon {
    font-size: 1rem;
  }
  
  .job-role {
    color: var(--terminal-green);
    font-size: 1.1rem;
    margin-bottom: 0.5rem;
    text-shadow: 0 0 10px rgba(0, 255, 65, 0.5);
  }
  
  .job-location {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--text-secondary);
    margin-bottom: 1rem;
    font-size: 1.1rem;
  }
  
  .location-icon {
    color: var(--accent-cyan);
  }
  
  .job-info-row {
    display: flex;
    align-items: flex-start;
    gap: 1.5rem;
    margin-bottom: 1rem;
  }
  
  .company-logo {
    flex-shrink: 0;
  }
  
  .company-image {
    width: 100px;
    height: 100px;
    object-fit: contain;
    border: 2px solid var(--terminal-green-dark);
    padding: 8px;
    background: var(--terminal-black);
  }
  
  .job-details {
    flex: 1;
  }
  
  .achievements,
  .projects-subsection {
    margin-top: 1.5rem;
    padding-top: 1.5rem;
    border-top: 2px dashed var(--terminal-green-dark);
  }
  
  .achievements-title,
  .projects-title {
    font-family: var(--font-pixel);
    font-size: 0.7rem;
    color: var(--accent-cyan);
    margin-bottom: 1rem;
  }
  
  .achievements-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  
  .achievement-item {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    color: var(--text-primary);
    line-height: 1.5;
  }
  
  .achievement-icon {
    color: var(--terminal-green);
    font-weight: bold;
    flex-shrink: 0;
  }
  
  .project-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  
  .project-card {
    background: var(--terminal-black);
    border: 2px solid var(--terminal-green-dark);
    padding: 1rem;
    transition: all 0.3s ease;
  }
  
  .project-card:hover {
    background: var(--terminal-green-dark);
    border-color: var(--terminal-green);
    transform: translateX(5px);
  }
  
  .project-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.5rem;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  
  .project-name {
    font-family: var(--font-pixel);
    font-size: 0.75rem;
    color: var(--terminal-green);
  }
  
  .project-client {
    font-family: var(--font-pixel);
    font-size: 0.6rem;
    color: var(--accent-yellow);
  }
  
  .project-period {
    font-size: 0.9rem;
    color: var(--text-secondary);
    margin-bottom: 0.5rem;
  }
  
  .project-description {
    font-size: 1rem;
    color: var(--text-primary);
    line-height: 1.5;
  }
  
  @media (max-width: 768px) {
    .timeline {
      padding-left: 30px;
    }
    
    .timeline::before {
      left: 8px;
    }
    
    .timeline-item::before {
      left: -30px;
      width: 16px;
      height: 16px;
    }
    
    .job-header {
      flex-direction: column;
      align-items: flex-start;
    }
    
    .job-card {
      padding: 1.5rem;
    }
  }
</style>
