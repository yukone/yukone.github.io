---
const education = [
  {
    degree: "Specialization Course in Computer Engineering",
    field: "Graphics and Multimedia Systems",
    institution: "Instituto Superior de Engenharia do Porto",
    period: "2011 - 2013",
    level: "MASTER CLASS",
    icon: "🎓",
    color: "#FF6B6B",
    image: "/images/edu-isep_logo.webp"
  },
  {
    degree: "Bachelor's Degree in Computer Engineering",
    field: "Software Development",
    institution: "Instituto Superior de Engenharia do Porto",
    period: "2006 - 2011",
    level: "UNDERGRAD",
    icon: "📚",
    color: "#4ECDC4",
    image: "/images/edu-isep_logo.webp"
  }
];

---

<section id="education" class="education">
  <div class="container">
    <h2 class="section-title fade-in">▶ EDUCATION QUEST ◀</h2>
    
    <div class="education-grid">
      {education.map((edu, index) => (
        <div class="education-card" style={`animation-delay: ${index * 0.2}s`}>
          <div class="diploma-frame">
            <div class="diploma-header" style={`background: ${edu.color}`}>
              <img src={edu.image} alt={edu.institution} class="diploma-logo" />
              <span class="diploma-degree-header">{edu.degree}</span>
            </div>
            
            <div class="diploma-content">
              <div class="diploma-seal">✓</div>
              
              <h3 class="degree-title">{edu.field}</h3>
              <div class="field-badge">{edu.degree}</div>
              
              <div class="institution-info">
                <div class="institution-row">
                  <span class="label">INSTITUTION:</span>
                  <span class="value">{edu.institution}</span>
                </div>
                <div class="institution-row">
                  <span class="label">PERIOD:</span>
                  <span class="value">{edu.period}</span>
                </div>
              </div>
              
              <div class="completion-badge">
                <span class="completion-icon">🏆</span>
                <span>COMPLETED</span>
              </div>
            </div>
            

          </div>
        </div>
      ))}
    </div>
  </div>
  
  <footer class="footer">
    <div class="container">
      <div class="footer-content">
        <div class="footer-logo">
          <span class="footer-icon">👾</span>
          <span>BRUNO ESTEVES</span>
        </div>
        <p class="footer-text">
          Crafted with 💚 and 16-bit nostalgia | © 2025 All Rights Reserved
        </p>
        <div class="footer-links">
          <a href="#hero" class="footer-link">↑ TOP</a>
        </div>
      </div>
    </div>
  </footer>
</section>

<style>
  .education {
    background: var(--terminal-black);
  }
  
  .education-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));
    gap: 3rem;
  }
  
  .education-card {
    opacity: 0;
    animation: fadeIn 0.6s ease-out forwards;
  }
  
  .diploma-frame {
    background: var(--terminal-black-light);
    border: 4px solid var(--terminal-green-dark);
    position: relative;
    padding: 2px;
    transition: all 0.3s ease;
  }
  
  .diploma-frame:hover {
    border-color: var(--terminal-green);
    box-shadow: 0 0 40px rgba(0, 255, 65, 0.2);
    transform: scale(1.02);
  }
  
  .diploma-header {
    padding: 0.75rem 1rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: var(--font-pixel);
    font-size: 0.6rem;
    color: var(--terminal-black);
    min-height: 60px;
  }
  
  .diploma-logo {
    width: 60px;
    height: 40px;
    object-fit: contain;
    background: var(--terminal-black);
    padding: 4px;
    border: 2px solid var(--terminal-black);
  }
  
  .diploma-degree-header {
    font-size: 0.55rem;
    text-align: right;
    max-width: 60%;
    line-height: 1.3;
  }
  
  .diploma-content {
    padding: 2rem;
    position: relative;
    background: var(--terminal-black);
  }
  
  .diploma-seal {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    width: 35px;
    height: 35px;
    background: var(--accent-yellow);
    border: 2px solid var(--terminal-black);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.2rem;
    color: var(--terminal-black);
    transform: rotate(-15deg);
  }
  
  .institution-logo {
    margin-bottom: 1.5rem;
    display: flex;
    justify-content: center;
  }
  
  .logo-image {
    max-width: 150px;
    max-height: 80px;
    object-fit: contain;
    border: 2px solid var(--terminal-green-dark);
    padding: 8px;
    background: var(--terminal-black);
  }
  
  .degree-title {
    font-family: var(--font-pixel);
    font-size: 0.85rem;
    color: var(--terminal-green);
    margin-bottom: 1rem;
    line-height: 1.4;
  }
  
  .field-badge {
    display: inline-block;
    background: var(--terminal-black);
    border: 2px solid var(--accent-cyan);
    color: var(--accent-cyan);
    padding: 0.5rem 1rem;
    font-family: var(--font-pixel);
    font-size: 0.6rem;
    margin-bottom: 1.5rem;
  }
  
  .institution-info {
    margin-bottom: 1.5rem;
  }
  
  .institution-row {
    display: flex;
    gap: 1rem;
    margin-bottom: 0.5rem;
    font-size: 1rem;
  }
  
  .label {
    color: var(--text-secondary);
    font-family: var(--font-pixel);
    font-size: 0.6rem;
    flex-shrink: 0;
    padding-top: 0.3rem;
  }
  
  .value {
    color: var(--text-primary);
  }
  
  .completion-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--terminal-green-dark);
    border: 3px solid var(--terminal-green);
    padding: 0.75rem 1.5rem;
    font-family: var(--font-pixel);
    font-size: 0.7rem;
    color: var(--terminal-black);
  }
  
  .completion-icon {
    font-size: 1.2rem;
  }
  
  /* Footer */
  .footer {
    margin-top: 4rem;
    padding-top: 3rem;
    border-top: 2px solid var(--terminal-green-dark);
  }
  
  .footer-content {
    text-align: center;
  }
  
  .footer-logo {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    font-family: var(--font-pixel);
    font-size: 0.9rem;
    color: var(--terminal-green);
    margin-bottom: 1rem;
  }
  
  .footer-icon {
    font-size: 1.5rem;
  }
  
  .footer-text {
    color: var(--text-secondary);
    font-size: 0.9rem;
    margin-bottom: 1.5rem;
  }
  
  .footer-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.5rem;
    background: var(--terminal-green-dark);
    border: 2px solid var(--terminal-green);
    font-family: var(--font-pixel);
    font-size: 0.6rem;
    color: var(--terminal-black);
    text-decoration: none;
    transition: all 0.3s ease;
  }
  
  .footer-link:hover {
    background: var(--terminal-green);
    box-shadow: 0 0 20px var(--terminal-green);
  }
  
  @media (max-width: 768px) {
    .education-grid {
      grid-template-columns: 1fr;
    }
    
    .diploma-content {
      padding: 1.5rem;
    }
    
    .diploma-seal {
      width: 40px;
      height: 40px;
      font-size: 1.2rem;
    }
  }
</style>
